# homelees reverse proxy: https://<service>.{$DOMAIN}
# DNS: *.{$DOMAIN} -> {$NB_IP} (NetBird, private). Values come from site.env. Wildcard cert via
# Cloudflare DNS-01, so no inbound port 80/443 from the internet is needed.
{
	default_bind {$LAN_IP} {$NB_IP} 127.0.0.1
	auto_https disable_redirects        # :80 belongs to Apache (landing page)
	admin off
}

# Authelia forward-auth (browser login + passkeys). API paths are bypassed in
# Authelia's access_control so mobile apps keep using their API keys.
(sso) {
	forward_auth 127.0.0.1:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

*.{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}
	encode zstd gzip
	# Never let a client supply identity headers; only Authelia (forward_auth
	# copy_headers, applied after this) may set them for an authenticated user.
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name

	@auth host auth.{$DOMAIN}
	handle @auth {
		reverse_proxy 127.0.0.1:9091
	}

	# ---- behind SSO (browser-only admin UIs) --------------------------------
	@home host home.{$DOMAIN}
	handle @home {
		import sso
		reverse_proxy 127.0.0.1:3000
	}
	@sonarr host sonarr.{$DOMAIN}
	handle @sonarr {
		import sso
		reverse_proxy 127.0.0.1:8989
	}
	@radarr host radarr.{$DOMAIN}
	handle @radarr {
		import sso
		reverse_proxy 127.0.0.1:7878
	}
	@shelfmark host shelfmark.{$DOMAIN}
	handle @shelfmark {
		import sso                              # + Shelfmark login (CWA accounts)
		reverse_proxy 127.0.0.1:8084
	}
	@books host books.{$DOMAIN}
	handle @books {
		import sso                              # /opds, /kosync bypassed (CWA basic auth)
		reverse_proxy 127.0.0.1:8083
	}
	@prowlarr host prowlarr.{$DOMAIN}
	handle @prowlarr {
		import sso
		reverse_proxy 127.0.0.1:9696
	}
	@bazarr host bazarr.{$DOMAIN}
	handle @bazarr {
		import sso
		reverse_proxy 127.0.0.1:6767
	}
	@sab host sab.{$DOMAIN}
	handle @sab {
		import sso
		reverse_proxy 127.0.0.1:8081
	}
	@torrent host torrent.{$DOMAIN}
	handle @torrent {
		import sso
		reverse_proxy 127.0.0.1:8080 {
			header_up Host 127.0.0.1:8080        # qBittorrent host-header validation
			header_up -Origin
			header_up -Referer
		}
	}
	@cockpit host cockpit.{$DOMAIN}
	handle @cockpit {
		import sso
		reverse_proxy https://127.0.0.1:9090 {
			transport http {
				tls_insecure_skip_verify     # Cockpit's self-signed cert, loopback only
			}
		}
	}

	# ---- own login / native apps (SSO via OIDC in the next stage) ------------
	@jellyfin host jellyfin.{$DOMAIN}
	handle @jellyfin {
		reverse_proxy 127.0.0.1:8096
	}
	@cloud host cloud.{$DOMAIN}
	handle @cloud {
		redir /.well-known/carddav /remote.php/dav 301
		redir /.well-known/caldav /remote.php/dav 301
		reverse_proxy 127.0.0.1:8082
	}
	@music host music.{$DOMAIN}
	handle @music {
		import sso                              # Navidrome trusts Remote-User from Caddy
		reverse_proxy 127.0.0.1:4533
	}
	@subsonic host subsonic.{$DOMAIN}
	handle @subsonic {
		reverse_proxy 127.0.0.1:5275           # octo-fiesta (Subsonic apps)
	}
	@requests host requests.{$DOMAIN}
	handle @requests {
		reverse_proxy 127.0.0.1:5055
	}
	@komodo host komodo.{$DOMAIN}
	handle @komodo {
		reverse_proxy 127.0.0.1:9120
	}
	@beszel host beszel.{$DOMAIN}
	handle @beszel {
		reverse_proxy 127.0.0.1:8090
	}
	@ferdium host ferdium.{$DOMAIN}
	handle @ferdium {
		reverse_proxy 127.0.0.1:3333
	}

	handle {
		abort
	}
}

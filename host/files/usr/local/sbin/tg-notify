#!/bin/sh
# tg-notify "message" — send a Telegram message to the homelees admin chat.
# Credentials: /etc/homelees/telegram.env (0600): TG_TOKEN=..., TG_CHAT_ID=...
# Without credentials the message only goes to the journal (tag tg-notify).
msg="$*"; [ -n "$msg" ] || msg="$(cat)"
logger -t tg-notify -- "$msg"
[ -r /etc/homelees/telegram.env ] || exit 0
. /etc/homelees/telegram.env
[ -n "${TG_TOKEN:-}" ] && [ -n "${TG_CHAT_ID:-}" ] || exit 0
curl -fsS -m 15 -o /dev/null \
  --data-urlencode "chat_id=${TG_CHAT_ID}" \
  --data-urlencode "text=🖥 homelees: ${msg}" \
  --data-urlencode "disable_web_page_preview=true" \
  "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" || logger -t tg-notify "send failed"

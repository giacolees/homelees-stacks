# Downloads stack configuration template.
# Copy to .env (chmod 600) and fill in real values; the real .env is gitignored.

# Gluetun VPN (ProtonVPN WireGuard with NAT-PMP port forwarding)
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=replace_with_wireguard_private_key
SERVER_COUNTRIES=Netherlands

# Jellyfin account used by Seerr integration
JELLYFIN_SEERR_USER=replace_me
JELLYFIN_SEERR_PASSWORD=replace_me

# qBittorrent WebUI credentials (used by gluetun's port-forward hook)
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=replace_me

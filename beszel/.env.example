# Beszel stack config. Copy to .env and adjust.
# For a GitHub release vX.Y.Z use the OCI version X.Y.Z.
TZ=Europe/Rome
BESZEL_VERSION=0.20.0
BESZEL_ADMIN_EMAIL=admin@homelees.local
BESZEL_ADMIN_PASSWORD=change-me

# Filled in from the hub's "Add System" dialog (Settings -> Systems):
#   BESZEL_AGENT_KEY   = hub public key
#   BESZEL_AGENT_TOKEN = per-system registration token
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=

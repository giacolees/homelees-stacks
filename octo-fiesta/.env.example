# Copy to .env (chmod 600 .env) and fill in the secrets.
# .env is gitignored; this template is committed.

TZ=Europe/Rome
# Forked build with the Deezer artist-radio patch (github.com/giacolees/octo-fiesta).
OCTO_FIESTA_TAG=v0.11-deezer-radio
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ----- Navidrome upstream (via the navidrome_default Docker network) -----
SUBSONIC_URL=http://navidrome:4533
# Optional. With admin creds octo-fiesta triggers a library scan immediately
# after a download; without them new tracks appear on Navidrome's 5m schedule.
SUBSONIC_ADMIN_USERNAME=
SUBSONIC_ADMIN_PASSWORD=

# ----- Proxy behaviour -----
MUSIC_SERVICE=Deezer
STORAGE_MODE=Permanent
DOWNLOAD_MODE=Track
# {track} is zero-padded to 2 digits, matching the existing library layout
# (e.g. "01 - Title.flac"). Other placeholders: {artistLetter} {disc} {year}
# {genre} {quality}.
FOLDER_TEMPLATE={artist}/{album}/{track} - {title}
EXPLICIT_FILTER=All
ENABLE_EXTERNAL_PLAYLISTS=true
PLAYLISTS_DIRECTORY=playlists
AUTO_UPGRADE_QUALITY=false
DISABLE_LIBRARY_SCAN=false

# ----- Deezer -----
# The `arl` cookie from a logged-in deezer.com browser session.
DEEZER_ARL=
DEEZER_ARL_FALLBACK=
# FLAC | MP3_320 | MP3_128 (empty = highest the account allows)
DEEZER_QUALITY=FLAC

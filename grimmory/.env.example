# Grimmory stack configuration template.
# Copy to .env and fill in the secrets (the real .env is gitignored).
# Docs: https://grimmory.org/docs/installation/

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Rome

# Image tag. Pin an explicit release; update deliberately.
GRIMMORY_VERSION=v3.5.0

# Application / database user (must match between the two services)
DB_USER=grimmory
DB_PASSWORD=replace_with_a_random_password

# MariaDB root password
MYSQL_ROOT_PASSWORD=replace_with_a_random_root_password

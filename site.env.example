# Site-specific values for every stack. Copy to site.env (gitignored), fill in,
# then run host/site-env.sh: it writes these into a managed block of each
# <stack>/.env so `docker compose` (CLI and Komodo) can interpolate them.
LAN_IP=192.168.1.10                  # host's LAN address (ports bind here + 127.0.0.1)
DOMAIN=example.com                   # HTTPS names: https://<service>.DOMAIN
TS_HOST=myhost.tailnet-name.ts.net   # Tailscale MagicDNS name
TS_IP=100.64.0.1                     # Tailscale IP
NB_HOST=myhost.netbird.cloud         # NetBird DNS name
NB_IP=100.100.0.1                    # NetBird IP (target of the *.DOMAIN DNS record)

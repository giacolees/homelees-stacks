# Immich stack configuration template.
# Copy to .env and fill in the secrets (the real .env is gitignored).
# Full variable reference: https://docs.immich.app/install/environment-variables

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Rome

# Where uploaded photos/videos and generated files are stored (bind mount).
UPLOAD_LOCATION=/mnt/media/Immich

# Immich image tag. Pin an explicit release; update deliberately.
IMMICH_VERSION=v3.2.2

# PostgreSQL credentials. DB_PASSWORD must be A-Za-z0-9 only (no symbols/spaces).
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_random_alphanumeric_password
DB_DATABASE_NAME=immich

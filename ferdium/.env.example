# Ferdium Server configuration template.
# Copy to .env and adjust as needed (the real .env is gitignored).

# Timezone
TZ=Europe/Rome

# Ferdium Server image tag (pinned release)
FERDIUM_VERSION=2.0.14

# Public/reachable URL of the Ferdium Server instance
APP_URL=http://myhost.tailnet-name.ts.net:3333

# Database settings (built-in SQLite stored in /data/ferdium.sqlite)
DB_CONNECTION=sqlite
DB_DATABASE=ferdium
DATA_DIR=/data
DB_SQLITE_JOURNAL_MODE=WAL
DB_SQLITE_SYNCHRONOUS=FULL
DB_BUSY_TIMEOUT=5000

# Feature flags
# Set IS_REGISTRATION_ENABLED=false after creating your personal account
# if you want to lock down new sign-ups.
IS_REGISTRATION_ENABLED=true
IS_DASHBOARD_ENABLED=true
IS_CREATION_ENABLED=true
CONNECT_WITH_FRANZ=true
JWT_USE_PEM=true

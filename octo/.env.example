# Copy to .env (chmod 600 .env) and adjust as needed.
TZ=Europe/Rome
OCTO_IMAGE_TAG=2026.10.28

# Upstream Navidrome server (via navidrome_default Docker network)
SUBSONIC_URL=http://navidrome:4533
SUBSONIC_ADMIN_USERNAME=
SUBSONIC_ADMIN_PASSWORD=
AUTO_DETECT_DOWNLOAD_PATH=true

# Search, On-Demand Streaming & Auto-Download
ENABLE_SEARCH_DISCOVERY=true
SIZE_FLAG_CLIENTS=Amperfy
COVER_BADGE=true
DOWNLOAD_SOURCE=YouTube
DOWNLOAD_ON_STAR=true
DOWNLOAD_ON_PLAY=true
STAR_DOWNLOADS_FOR_REQUESTER=true
FOLDER_STRUCTURE=Organized
LYRICS_FETCH=true

# yt-dlp-shim low-latency stream resolution
YTDLP_PLAYER_CLIENT=visionos

# Multi-source Radio & Acoustic Analysis
RADIO_YOUTUBE_MUSIC=true
RADIO_LISTENBRAINZ=true
RADIO_SOUNDS_ALIKE=true
SONIC_USER=1000:1000
SONIC_CPUS=1

# Generated Playlists & Mixes
POPULAR_NOW=true
MIXES_ENABLED=true
FOR_YOU_NEW_RELEASES=true
FOR_YOU_REDISCOVER=true
FOR_YOU_DEEP_CUTS=true
LIKED_SONGS=true

# Optional Last.fm API credentials
LASTFM_API_KEY=
LASTFM_API_SECRET=

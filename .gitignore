# Secrets and credentials — never commit these
.env
.env.*
!.env.example
*.env
*.secret
*.key
*.pem
*.p12
*.pfx
id_rsa*
known_hosts

# Dockge / runtime state
/opt/dockge/data/
**/data/
**/config/
**/secrets/

# Common app state that should not be versioned
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log

# OS / editor noise
.DS_Store
*.swp
*~

# Homepage config: track only the files we author, not runtime output
!homepage/config/
homepage/config/*
!homepage/config/services.yaml
!homepage/config/settings.yaml
!homepage/config/widgets.yaml
!homepage/config/bookmarks.yaml
!homepage/config/docker.yaml

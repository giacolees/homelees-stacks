# Secrets and credentials — never commit these
.env
.env.*
!.env.example
site.env              # site values (LAN IP, domain, VPN names) — template: site.env.example
*.env
*.secret
*.key
*.pem
*.p12
*.pfx
id_rsa*
known_hosts

# Dockge / runtime state
/opt/dockge/data/
**/data/
**/config/
**/secrets/

# Common app state that should not be versioned
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log

# OS / editor noise
.DS_Store
*.swp
*~

# Homepage config: track only the files we author, not runtime output
!homepage/config/
homepage/config/*
!homepage/config/services.yaml
!homepage/config/settings.yaml
!homepage/config/widgets.yaml
!homepage/config/bookmarks.yaml

# Cloned app repo (has its own .git)
/wellness/

# Versioned helper scripts that live under otherwise-ignored config dirs
!downloads/config/
downloads/config/*
!downloads/config/gluetun/
downloads/config/gluetun/*
!downloads/config/gluetun/update-qbittorrent-port.sh

# Agent guide symlinks (real file: /home/giacolees/AGENT.md)
/AGENT.md
/AGENTS.md

# Komodo generated admin credentials
komodo/.generated-credentials
__pycache__/

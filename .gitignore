# Secrets and credentials — never commit these
.env
.env.*
!.env.example
*.env
*.secret
*.key
*.pem
*.p12
*.pfx
id_rsa*
known_hosts

# Dockge / runtime state
/opt/dockge/data/
**/data/
**/config/
**/secrets/

# Common app state that should not be versioned
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log

# OS / editor noise
.DS_Store
*.swp
*~
